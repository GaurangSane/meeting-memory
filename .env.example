# ════════════════════════════════════════════════════════════════════
#  .env.example — Intelligent Meeting Memory SaaS
#  Copy this file to .env and fill in real values before running.
# ════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://mom_admin:change_me@postgres:5432/mom_saas_db

# ── Redis / Celery ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
WS_TICKET_EXPIRE_SECONDS=30

# ── Sarvam AI ──────────────────────────────────────────────
SARVAM_API_KEY=your_key
SARVAM_STT_MODEL=saaras:v3
SARVAM_LANGUAGE_CODE=hi-IN      # hi-IN | en-IN | ta-IN | te-IN | kn-IN | mr-IN

# ── Google Gemini ──────────────────────────────────────────
GEMINI_API_KEY=your_key
GEMINI_MODEL=gemini-1.5-pro-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ── Email (Gmail SMTP) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=app_password
EMAIL_FROM_NAME=MOM Generator Bot
EMAIL_RECIPIENTS=manager@company.com,team@company.com

# ── Twilio ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_RECIPIENTS=whatsapp:+919876543210,whatsapp:+919123456789

# ── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
ALLOWED_ORIGINS=http://localhost

# ── Desktop App Legacy (kept for backward compat) ──────────
CHUNK_DURATION_SECONDS=30
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
LOG_LEVEL=INFO
